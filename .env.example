# metaxisdata demo configuration.
#
# Copy this file to `.env` (`make up` does it for you) and change anything you like.
# Every value here is a throwaway local demo value -- never reuse it anywhere real.
# Generated secrets (OpenLineage ingestion keys, application keys) are not here: they
# are created at runtime into the gitignored state/ volume.

# --- platform -----------------------------------------------------------------
# Published tags: v0.1.1, 0.1.1, latest, sha-<commit>. Pinned so the demo is reproducible.
METAXISDATA_VERSION=v0.1.1
METAXISDATA_PORT=8083
AIRFLOW_PORT=8080

# --- platform store -----------------------------------------------------------
STORE_USER=demo
STORE_PASSWORD=demo
STORE_DB=metaxisdata

# --- demo administrator (created by bootstrap) --------------------------------
# The workspace password policy requires length, digits, letters, uppercase and a special character.
ADMIN_EMAIL=admin@demo.local
ADMIN_PASSWORD=Demo-admin-1234!

# --- demo database accounts ---------------------------------------------------
MYSQL_ROOT_PASSWORD=demo-root
DEMO_USER=demo
DEMO_PASSWORD=demo

# --- data source hostnames ----------------------------------------------------
# These are compose service names. The demo registers its instances with exactly these
# values, and the pipelines use the same ones: OpenLineage resolves a dataset by matching
# host:port against a registered instance, so a different spelling silently produces an
# external dataset instead of real lineage.
MYSQL_HOST=mysql-shop
MYSQL_PORT=3306
MYSQL_DB=shop
PG_HOST=postgres-warehouse
PG_PORT=5432
PG_DB=warehouse
SR_HOST=starrocks-serving
SR_PORT=9030

# --- build-time mirrors (optional) --------------------------------------------
# The Airflow image is built locally. Point these at a mirror when the default
# indexes are not reachable.
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# --- misc ---------------------------------------------------------------------
TZ=UTC
